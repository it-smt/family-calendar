# Copy to .env beside docker-compose.prod.yml and fill in. Nothing here has a
# default in the production compose file: a secret with a fallback is a secret
# that ships.

# --- The database ------------------------------------------------------------
POSTGRES_USER=fc
POSTGRES_PASSWORD=          # openssl rand -base64 24
POSTGRES_DB=family_calendar

# --- Tokens ------------------------------------------------------------------
# Signs every access token. Changing it later signs everyone out of both
# phones, which is also how you sign out a phone you have lost.
FC_JWT_SECRET=              # openssl rand -base64 48

# --- The name the phones will use --------------------------------------------
# An A record pointing at this machine. Caddy gets the certificate for it.
FC_DOMAIN=calendar.example.com
FC_ACME_EMAIL=you@example.com

# --- Push notifications (optional) -------------------------------------------
# Without these the other phone finds out on its next launch instead of
# immediately. Everything else works. Needs a paid developer account.
FC_APNS_KEY_ID=
FC_APNS_TEAM_ID=
FC_APNS_TOPIC=              # the app's bundle identifier
FC_APNS_KEY_PATH=/srv/secrets/AuthKey.p8
FC_APNS_USE_SANDBOX=false

# --- Backups -----------------------------------------------------------------
FC_BACKUP_KEEP_DAYS=30
