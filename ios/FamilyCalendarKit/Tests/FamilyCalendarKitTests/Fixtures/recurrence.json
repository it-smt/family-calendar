{
  "_comment": [
    "Cases for expanding a recurring task into concrete instants.",
    "",
    "Written by hand, then checked against python-dateutil's RFC 5545",
    "implementation by server/tests/test_recurrence_fixtures.py, so the expected",
    "values are the standard's answers and not this project's opinion of them.",
    "RecurrenceTests.swift reads the same file, which is what ties the Swift",
    "expander to the standard without trusting either end.",
    "",
    "Times are RFC 3339 UTC with milliseconds, the format the whole system uses."
  ],
  "cases": [
    {
      "name": "no rule at all is a single occurrence",
      "rrule": null,
      "starts_at": "2026-09-20T09:00:00.000Z",
      "window": ["2026-09-01T00:00:00.000Z", "2026-10-01T00:00:00.000Z"],
      "expected": ["2026-09-20T09:00:00.000Z"]
    },
    {
      "name": "a single occurrence outside the window is not returned",
      "rrule": null,
      "starts_at": "2026-08-20T09:00:00.000Z",
      "window": ["2026-09-01T00:00:00.000Z", "2026-10-01T00:00:00.000Z"],
      "expected": []
    },
    {
      "name": "every day",
      "rrule": "FREQ=DAILY",
      "starts_at": "2026-09-28T07:30:00.000Z",
      "window": ["2026-09-28T00:00:00.000Z", "2026-10-03T00:00:00.000Z"],
      "expected": [
        "2026-09-28T07:30:00.000Z",
        "2026-09-29T07:30:00.000Z",
        "2026-09-30T07:30:00.000Z",
        "2026-10-01T07:30:00.000Z",
        "2026-10-02T07:30:00.000Z"
      ]
    },
    {
      "name": "every other day",
      "rrule": "FREQ=DAILY;INTERVAL=2",
      "starts_at": "2026-09-28T07:30:00.000Z",
      "window": ["2026-09-28T00:00:00.000Z", "2026-10-05T00:00:00.000Z"],
      "expected": [
        "2026-09-28T07:30:00.000Z",
        "2026-09-30T07:30:00.000Z",
        "2026-10-02T07:30:00.000Z",
        "2026-10-04T07:30:00.000Z"
      ]
    },
    {
      "name": "the window starts after the rule does",
      "rrule": "FREQ=DAILY",
      "starts_at": "2026-09-01T07:30:00.000Z",
      "window": ["2026-09-28T00:00:00.000Z", "2026-10-01T00:00:00.000Z"],
      "expected": [
        "2026-09-28T07:30:00.000Z",
        "2026-09-29T07:30:00.000Z",
        "2026-09-30T07:30:00.000Z"
      ]
    },
    {
      "name": "weekly on the starting weekday",
      "rrule": "FREQ=WEEKLY",
      "starts_at": "2026-09-19T10:00:00.000Z",
      "window": ["2026-09-01T00:00:00.000Z", "2026-10-15T00:00:00.000Z"],
      "expected": [
        "2026-09-19T10:00:00.000Z",
        "2026-09-26T10:00:00.000Z",
        "2026-10-03T10:00:00.000Z",
        "2026-10-10T10:00:00.000Z"
      ]
    },
    {
      "name": "swimming on Tuesdays and Thursdays",
      "rrule": "FREQ=WEEKLY;BYDAY=TU,TH",
      "starts_at": "2026-09-22T18:00:00.000Z",
      "window": ["2026-09-20T00:00:00.000Z", "2026-10-05T00:00:00.000Z"],
      "expected": [
        "2026-09-22T18:00:00.000Z",
        "2026-09-24T18:00:00.000Z",
        "2026-09-29T18:00:00.000Z",
        "2026-10-01T18:00:00.000Z"
      ]
    },
    {
      "name": "every second week on one day",
      "rrule": "FREQ=WEEKLY;INTERVAL=2;BYDAY=MO",
      "starts_at": "2026-09-07T08:00:00.000Z",
      "window": ["2026-09-01T00:00:00.000Z", "2026-10-20T00:00:00.000Z"],
      "expected": [
        "2026-09-07T08:00:00.000Z",
        "2026-09-21T08:00:00.000Z",
        "2026-10-05T08:00:00.000Z",
        "2026-10-19T08:00:00.000Z"
      ]
    },
    {
      "name": "a fixed number of times",
      "rrule": "FREQ=WEEKLY;COUNT=3",
      "starts_at": "2026-09-19T10:00:00.000Z",
      "window": ["2026-09-01T00:00:00.000Z", "2026-12-01T00:00:00.000Z"],
      "expected": [
        "2026-09-19T10:00:00.000Z",
        "2026-09-26T10:00:00.000Z",
        "2026-10-03T10:00:00.000Z"
      ]
    },
    {
      "name": "until a date, inclusive of that instant",
      "rrule": "FREQ=DAILY;UNTIL=20260930T073000Z",
      "starts_at": "2026-09-28T07:30:00.000Z",
      "window": ["2026-09-01T00:00:00.000Z", "2026-12-01T00:00:00.000Z"],
      "expected": [
        "2026-09-28T07:30:00.000Z",
        "2026-09-29T07:30:00.000Z",
        "2026-09-30T07:30:00.000Z"
      ]
    },
    {
      "name": "monthly on the same day of the month",
      "rrule": "FREQ=MONTHLY",
      "starts_at": "2026-09-15T12:00:00.000Z",
      "window": ["2026-09-01T00:00:00.000Z", "2027-01-01T00:00:00.000Z"],
      "expected": [
        "2026-09-15T12:00:00.000Z",
        "2026-10-15T12:00:00.000Z",
        "2026-11-15T12:00:00.000Z",
        "2026-12-15T12:00:00.000Z"
      ]
    },
    {
      "name": "monthly on the 31st skips the months that have none",
      "rrule": "FREQ=MONTHLY;BYMONTHDAY=31",
      "starts_at": "2026-01-31T09:00:00.000Z",
      "window": ["2026-01-01T00:00:00.000Z", "2026-07-01T00:00:00.000Z"],
      "expected": [
        "2026-01-31T09:00:00.000Z",
        "2026-03-31T09:00:00.000Z",
        "2026-05-31T09:00:00.000Z"
      ]
    },
    {
      "name": "yearly",
      "rrule": "FREQ=YEARLY",
      "starts_at": "2026-03-08T00:00:00.000Z",
      "window": ["2026-01-01T00:00:00.000Z", "2029-01-01T00:00:00.000Z"],
      "expected": [
        "2026-03-08T00:00:00.000Z",
        "2027-03-08T00:00:00.000Z",
        "2028-03-08T00:00:00.000Z"
      ]
    },
    {
      "name": "cancelled occurrences are skipped",
      "rrule": "FREQ=WEEKLY",
      "starts_at": "2026-09-19T10:00:00.000Z",
      "window": ["2026-09-01T00:00:00.000Z", "2026-10-15T00:00:00.000Z"],
      "exceptions": ["2026-09-26T10:00:00.000Z"],
      "expected": [
        "2026-09-19T10:00:00.000Z",
        "2026-10-03T10:00:00.000Z",
        "2026-10-10T10:00:00.000Z"
      ]
    },
    {
      "name": "a rule with no start has nothing to expand",
      "rrule": "FREQ=DAILY",
      "starts_at": null,
      "window": ["2026-09-01T00:00:00.000Z", "2026-10-01T00:00:00.000Z"],
      "expected": []
    }
  ]
}
